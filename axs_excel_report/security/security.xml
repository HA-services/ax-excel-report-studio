<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_excel_report" model="ir.module.category">
        <field name="name">Excel Report Studio</field>
        <field name="sequence">60</field>
    </record>

    <record id="privilege_excel_report" model="res.groups.privilege">
        <field name="name">Excel Report Studio</field>
        <field name="sequence">60</field>
        <field name="category_id" ref="module_category_excel_report"/>
    </record>

    <record id="group_excel_manager" model="res.groups">
        <field name="name">Excel Report Manager</field>
        <field name="privilege_id" ref="privilege_excel_report"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
        <field name="comment">Creates and designs Excel report templates.</field>
    </record>
</odoo>
