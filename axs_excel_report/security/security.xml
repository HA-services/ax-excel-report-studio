<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_excel_report" model="ir.module.category">
        <field name="name">Excel Report Studio</field>
        <field name="sequence">60</field>
    </record>

    <record id="group_excel_manager" model="res.groups">
        <field name="name">Excel Report Manager</field>
        <field name="category_id" ref="module_category_excel_report"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
        <field name="comment">Creates and designs Excel report templates.</field>
    </record>

    <record id="rule_excel_template_company" model="ir.rule">
        <field name="name">Excel templates: multi-company</field>
        <field name="model_id" ref="model_axs_excel_template"/>
        <field name="domain_force">['|', ('company_ids', '=', False), ('company_ids', 'in', company_ids)]</field>
    </record>
</odoo>
